# Copy this file to .env before running `docker compose up`.
#   cp .env.example .env
# .env is gitignored — put real credentials there, never here.

# ============================================================================
# PORTS (host side — change if something else already uses these)
# ============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Use 3307 if you already run MySQL locally — 3306 will be taken.
DB_PORT=3307

# ============================================================================
# BACKEND
# ============================================================================
ENVIRONMENT=development

# Only needed for `npm run dev` against the published backend port. The Docker
# frontend proxies /api same-origin, so it never triggers CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# IMPORTANT: anyone holding this secret can forge a login token for any user.
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production-please

# ============================================================================
# DATABASE (MySQL 8)
# ============================================================================
# The backend connects as MYSQL_USER, not root. DATABASE_URL is assembled from
# these in docker-compose.yml, so there is no connection string to keep in sync.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=p2p_db
MYSQL_USER=p2puser
MYSQL_PASSWORD=p2ppass
