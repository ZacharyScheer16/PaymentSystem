# Stage 1: Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Optional override for when the API is on a different origin than the page.
# Left empty by default so the bundle uses the relative "/api" base and nginx
# proxies it — see src/api.js. Must be set at BUILD time, not runtime, because
# Vite inlines env vars into the bundle.
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE

# Build the application
RUN npm run build

# Stage 2: Runtime stage
FROM nginx:alpine

# Copy built app from builder stage to nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# 127.0.0.1, not localhost: localhost resolves to the IPv6 [::1] in this image,
# but nginx's `listen 80` binds IPv4 only — so localhost gets connection refused
# and the container is reported unhealthy while actually serving fine.
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
